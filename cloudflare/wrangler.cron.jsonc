{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-helper-cron",
  "main": "cloudflare/cron-worker.ts",
  "compatibility_date": "2026-11-01",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "TG_HELPER_URL": "REPLACE_WITH_CLOUDFLARE_APP_WORKER_URL"
  },
  "observability": {
    "enabled": true
  }
}

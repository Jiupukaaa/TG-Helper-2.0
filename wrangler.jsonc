{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-helper-2-0",
  "keep_vars": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-helper",
      "database_id": "b9ce1a8b-4767-4b0d-8141-9ff9da63ed48",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}


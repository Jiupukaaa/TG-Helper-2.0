# --- Telegram ---
# Get this from @BotFather after creating your bot.
TELEGRAM_BOT_TOKEN=

# A random secret string you choose yourself. Set the exact same value when
# you register the webhook with Telegram (see README). Telegram will echo it
# back in the X-Telegram-Bot-Api-Secret-Token header on every webhook call,
# which the webhook endpoint checks before processing anything.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Find your own ID by messaging @userinfobot on Telegram.
# Leave empty to deny everyone (safe default — do not leave this blank in
# production if you actually want to use the bot).
ALLOWED_TELEGRAM_IDS=

# --- Database (Neon) ---
# Postgres connection string, e.g.
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Cron ---
# Another random secret string you choose. Set it in Vercel's environment
# variables — the /api/cron/reminders endpoint checks it against the
# "Authorization: Bearer <CRON_SECRET>" header on every call.
# The regular trigger is now a GitHub Actions workflow (see README §7), not
# Vercel Cron — so this same value must ALSO be added as a repository
# secret named CRON_SECRET in GitHub (Settings → Secrets and variables →
# Actions). It's one secret used in two places, not two separate secrets.
CRON_SECRET=

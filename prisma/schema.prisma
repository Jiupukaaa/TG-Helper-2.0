// TG Helper — Prisma schema
// Postgres (Neon) is the target database. Do not use SQLite in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
// One row per allowed Telegram user. Access control (allowlist) itself lives
// in an environment variable (ALLOWED_TELEGRAM_IDS), not in this table — this
// table just stores per-user preferences and owns their data.
model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  // IANA timezone name, e.g. "Europe/Amsterdam". Defaults to UTC until the
  // user runs /settimezone. Reminder date/time input is rejected until this
  // is set to something other than the default (see reminder UX in README).
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes     Note[]
  reminders Reminder[]
  session   Session?

  @@map("users")
}

// ---------------------------------------------------------------------------
// Note
// ---------------------------------------------------------------------------
model Note {
  id        Int      @id @default(autoincrement())
  text      String
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Reminder
// ---------------------------------------------------------------------------
// PENDING    -> waiting for dueAt to arrive
// PROCESSING -> a cron run has claimed this row and is (about to be) sending it
// SENT       -> successfully delivered
// FAILED     -> delivery permanently failed (e.g. bot blocked) or retries exhausted
enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Reminder {
  id      Int    @id @default(autoincrement())
  text    String
  // Always stored in UTC. Conversion to/from the user's local time happens
  // only at the input/display boundary (see src/lib/time.ts).
  dueAt   DateTime
  status  ReminderStatus @default(PENDING)

  // Set when a cron run claims the row (moves it to PROCESSING). Used to
  // detect and recover stuck rows if a run crashes after claiming but
  // before finishing (see reclaim logic in the cron endpoint).
  processingStartedAt DateTime?

  sentAt     DateTime?
  retryCount Int       @default(0)
  lastError  String?

  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite index backing the cron's selection query:
  // WHERE status = 'PENDING' AND dueAt <= now()
  // (and the stuck-PROCESSING reclaim variant of the same query).
  @@index([status, dueAt])
  @@index([ownerId])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// Session
// ---------------------------------------------------------------------------
// Multi-step conversation state (e.g. "creating a reminder": text -> date ->
// confirm). Stored in the DB rather than in memory because serverless
// functions give no guarantee of a warm instance between webhook calls.
enum SessionStep {
  IDLE
  NOTE_AWAITING_TEXT
  NOTE_EDIT_AWAITING_TEXT
  REMINDER_AWAITING_TEXT
  REMINDER_AWAITING_DATETIME
}

model Session {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step SessionStep @default(IDLE)

  // Free-form scratch space for the in-progress draft (draft note text,
  // draft reminder text, the target note/reminder id being edited, etc).
  // Kept as a single JSON blob to avoid adding a column per scenario.
  draft Json?

  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// TG Helper — Prisma schema
// Postgres (Neon) is the target database. Do not use SQLite in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes     Note[]
  reminders Reminder[]
  shifts    Shift[]
  session   Session?

  @@map("users")
}

model Note {
  id          Int      @id @default(autoincrement())
  text        String
  voiceFileId String?
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("notes")
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Reminder {
  id      Int    @id @default(autoincrement())
  text    String
  dueAt   DateTime
  status  ReminderStatus @default(PENDING)

  processingStartedAt DateTime?
  sentAt              DateTime?
  retryCount          Int       @default(0)
  lastError           String?

  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shiftId   Int?
  shift     Shift?   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  offsetMinutes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftId, offsetMinutes])
  @@index([status, dueAt])
  @@index([ownerId])
  @@index([shiftId])
  @@map("reminders")
}

model Shift {
  id              Int        @id @default(autoincrement())
  name            String?
  startAt         DateTime
  ownerId         Int
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cycleGroupId    String?
  reminders       Reminder[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([ownerId, startAt])
  @@index([ownerId, startAt])
  @@index([ownerId, cycleGroupId])
  @@map("shifts")
}

enum SessionStep {
  IDLE
  NOTE_AWAITING_TEXT
  NOTE_EDIT_AWAITING_TEXT
  REMINDER_AWAITING_TEXT
  REMINDER_AWAITING_DATETIME
  SHIFT_MANUAL_AWAITING_TIME
  SHIFT_MANUAL_AWAITING_NAME
  SHIFT_CYCLE_AWAITING_WORK_DAYS
  SHIFT_CYCLE_AWAITING_OFF_DAYS
  SHIFT_CYCLE_AWAITING_START_DATE
  SHIFT_CYCLE_AWAITING_TIME
  SHIFT_CYCLE_AWAITING_END_DATE
  SHIFT_CYCLE_AWAITING_NAME
  SHIFT_EDIT_AWAITING_NAME
}

model Session {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step SessionStep @default(IDLE)
  draft Json?
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

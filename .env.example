# --- Telegram ---
# Configure as Cloudflare Worker secrets, not in wrangler.jsonc.
TELEGRAM_BOT_TOKEN=

# Register this exact value as Telegram's webhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Leave empty to deny everyone.
ALLOWED_TELEGRAM_IDS=

# --- Cron ---
# Shared secret checked by /api/cron/reminders. Configure as a Worker secret.
CRON_SECRET=

# Database: Cloudflare D1 binding "DB" in wrangler.jsonc.
# Do not put Neon/PostgreSQL credentials here for the D1 deployment.
